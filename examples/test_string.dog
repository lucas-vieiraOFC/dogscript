use <string>

func create main() {
    var create ok bool = true;
    if string.upper(str("dog")) != str("DOG") then { ok = false; }
    if string.len(str("abc")) != 3 then { ok = false; }
    if string.contains(str("abcdef"), str("cd")) = false then { ok = false; }
    if ok then {
        print(str("PASS string"));
    } else {
        print(str("FAIL string"));
    }
}

func exec main();
