@extern func create __str_upper(s str) str;
@extern func create __str_lower(s str) str;
@extern func create __str_trim(s str) str;
@extern func create __str_trimleft(s str) str;
@extern func create __str_trimright(s str) str;
@extern func create __str_split(s str, delim str) list;
@extern func create __str_join(parts list, delim str) str;
@extern func create __str_replace(s str, old str, new str) str;
@extern func create __str_contains(s str, sub str) bool;
@extern func create __str_startswith(s str, prefix str) bool;
@extern func create __str_endswith(s str, suffix str) bool;
@extern func create __str_len(s str) int;
@extern func create __str_index(s str, sub str) int;
@extern func create __str_slice(s str, start int, end int) str;
@extern func create __str_repeat(s str, n int) str;
@extern func create __str_reverse(s str) str;
@extern func create __str_pad(s str, width int, char str) str;
@extern func create __str_count(s str, sub str) int;
@extern func create __str_isdigit(s str) bool;
@extern func create __str_isalpha(s str) bool;

func create upper(s str) str { return __str_upper(s); }
func create lower(s str) str { return __str_lower(s); }
func create trim(s str) str { return __str_trim(s); }
func create trimleft(s str) str { return __str_trimleft(s); }
func create trimright(s str) str { return __str_trimright(s); }
func create split(s str, delim str) list { return __str_split(s, delim); }
func create join(parts list, delim str) str { return __str_join(parts, delim); }
func create replace(s str, old str, new str) str { return __str_replace(s, old, new); }
func create contains(s str, sub str) bool { return __str_contains(s, sub); }
func create startswith(s str, prefix str) bool { return __str_startswith(s, prefix); }
func create endswith(s str, suffix str) bool { return __str_endswith(s, suffix); }
func create len(s str) int { return __str_len(s); }
func create index(s str, sub str) int { return __str_index(s, sub); }
func create slice(s str, start int, end int) str { return __str_slice(s, start, end); }
func create repeat(s str, n int) str { return __str_repeat(s, n); }
func create reverse(s str) str { return __str_reverse(s); }
func create pad(s str, width int, char str) str { return __str_pad(s, width, char); }
func create count(s str, sub str) int { return __str_count(s, sub); }
func create isdigit(s str) bool { return __str_isdigit(s); }
func create isalpha(s str) bool { return __str_isalpha(s); }
