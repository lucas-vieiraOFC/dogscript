@extern func create __io_print(msg str) null;
@extern func create __io_println(msg str) null;
@extern func create __io_input(prompt str) str;
@extern func create __io_clear() null;
@extern func create __io_color(code int) null;
@extern func create __io_bold(msg str) str;
@extern func create __io_underline(msg str) str;
@extern func create __io_table(headers list, rows list) null;
@extern func create __io_progress(current int, total int, label str) null;

func create print(msg str) null { return __io_print(msg); }
func create println(msg str) null { return __io_println(msg); }
func create input(prompt str) str { return __io_input(prompt); }
func create clear() null { return __io_clear(); }
func create color(code int) null { return __io_color(code); }
func create bold(msg str) str { return __io_bold(msg); }
func create underline(msg str) str { return __io_underline(msg); }
func create table(headers list, rows list) null { return __io_table(headers, rows); }
func create progress(current int, total int, label str) null { return __io_progress(current, total, label); }
