@extern func create __sys_exit(code int) null;
@extern func create __sys_argv() list;
@extern func create __sys_platform() str;
@extern func create __sys_version() str;
@extern func create __sys_memused() int;
@extern func create __sys_memtotal() int;
@extern func create __sys_cpucount() int;
@extern func create __sys_stdin_read() str;
@extern func create __sys_stderr_write(msg str) null;

func create exit(code int) null { return __sys_exit(code); }
func create argv() list { return __sys_argv(); }
func create platform() str { return __sys_platform(); }
func create version() str { return __sys_version(); }
func create memused() int { return __sys_memused(); }
func create memtotal() int { return __sys_memtotal(); }
func create cpucount() int { return __sys_cpucount(); }
func create stdin() str { return __sys_stdin_read(); }
func create stderr(msg str) null { return __sys_stderr_write(msg); }
