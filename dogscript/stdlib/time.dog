@extern func create __time_now() int;
@extern func create __time_sleep(ms int) null;
@extern func create __time_format(ts int, fmt str) str;
@extern func create __time_parse(s str, fmt str) int;
@extern func create __time_year(ts int) int;
@extern func create __time_month(ts int) int;
@extern func create __time_day(ts int) int;
@extern func create __time_hour(ts int) int;
@extern func create __time_minute(ts int) int;
@extern func create __time_second(ts int) int;
@extern func create __time_diff(ts1 int, ts2 int) int;
@extern func create __time_add(ts int, seconds int) int;

func create now() int { return __time_now(); }
func create sleep(ms int) null { return __time_sleep(ms); }
func create format(ts int, fmt str) str { return __time_format(ts, fmt); }
func create parse(s str, fmt str) int { return __time_parse(s, fmt); }
func create year(ts int) int { return __time_year(ts); }
func create month(ts int) int { return __time_month(ts); }
func create day(ts int) int { return __time_day(ts); }
func create hour(ts int) int { return __time_hour(ts); }
func create minute(ts int) int { return __time_minute(ts); }
func create second(ts int) int { return __time_second(ts); }
func create diff(ts1 int, ts2 int) int { return __time_diff(ts1, ts2); }
func create add(ts int, seconds int) int { return __time_add(ts, seconds); }
