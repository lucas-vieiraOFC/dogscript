@extern func create __math_sqrt(x float) float;
@extern func create __math_pow(base float, exp float) float;
@extern func create __math_abs(x float) float;
@extern func create __math_floor(x float) int;
@extern func create __math_ceil(x float) int;
@extern func create __math_round(x float) int;
@extern func create __math_log(x float) float;
@extern func create __math_log2(x float) float;
@extern func create __math_log10(x float) float;
@extern func create __math_sin(x float) float;
@extern func create __math_cos(x float) float;
@extern func create __math_tan(x float) float;
@extern func create __math_pi() float;
@extern func create __math_e() float;
@extern func create __math_rand() float;
@extern func create __math_randint(min int, max int) int;
@extern func create __math_min(a float, b float) float;
@extern func create __math_max(a float, b float) float;
@extern func create __math_clamp(val float, min float, max float) float;

const pi float = __math_pi();
const e float = __math_e();

func create sqrt(x float) float { return __math_sqrt(x); }
func create pow(base float, exp float) float { return __math_pow(base, exp); }
func create abs(x float) float { return __math_abs(x); }
func create floor(x float) int { return __math_floor(x); }
func create ceil(x float) int { return __math_ceil(x); }
func create round(x float) int { return __math_round(x); }
func create log(x float) float { return __math_log(x); }
func create log2(x float) float { return __math_log2(x); }
func create log10(x float) float { return __math_log10(x); }
func create sin(x float) float { return __math_sin(x); }
func create cos(x float) float { return __math_cos(x); }
func create tan(x float) float { return __math_tan(x); }
func create rand() float { return __math_rand(); }
func create randint(min int, max int) int { return __math_randint(min, max); }
func create min(a float, b float) float { return __math_min(a, b); }
func create max(a float, b float) float { return __math_max(a, b); }
func create clamp(val float, min float, max float) float { return __math_clamp(val, min, max); }
