use <os>

func create main() {
    var create ok bool = true;
    var create p str = str("tmp_test_os.txt");
    os.file_write(p, str("hello"));
    if os.file_exists(p) = false then { ok = false; }
    if os.file_size(p) <= 0 then { ok = false; }
    var create s str = os.file_read(p);
    if s = null then { ok = false; }
    os.file_remove(p);
    if ok then {
        print(str("PASS os"));
    } else {
        print(str("FAIL os"));
    }
}

func exec main();
