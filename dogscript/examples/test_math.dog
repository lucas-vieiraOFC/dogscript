use <math>

func create main() {
    var create ok bool = true;
    if math.sqrt(float(16.0)) != float(4.0) then { ok = false; }
    if math.pow(float(2.0), float(3.0)) != float(8.0) then { ok = false; }
    if math.pi <= float(3.0) then { ok = false; }
    if ok then {
        print(str("PASS math"));
    } else {
        print(str("FAIL math"));
    }
}

func exec main();
