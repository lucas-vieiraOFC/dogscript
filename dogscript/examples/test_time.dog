use <time>

func create main() {
    var create ok bool = true;
    var create now int = time.now();
    if now <= 0 then { ok = false; }
    var create later int = time.add(now, 5);
    if time.diff(now, later) != 5 then { ok = false; }
    if ok then {
        print(str("PASS time"));
    } else {
        print(str("FAIL time"));
    }
}

func exec main();
